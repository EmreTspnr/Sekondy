          "raw": "{\n  \"firstName\": \"Sinan\",\n  \"lastName\": \"Viewer\",\n  \"email\": \"sinan_viewer_{{runId}}@test.com\",\n  \"password\": \"123456\",\n  \"phone\": \"5553003000\",\n  \"address\": \"Istanbul\"\n}",
